{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": [],
    "lib": ["ES2022", "DOM", "ESNext.Disposable"]
  },
  "include": ["src/**/*.ts"]
}
